{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionar.example/knowledge/schemas/anatomy.schema.json",
  "title": "VisionAR Anatomy Entity",
  "type": "object",
  "additionalProperties": false,

  "allOf": [
    {
      "$ref": "common/base-entity.schema.json"
    }
  ],

  "properties": {

    "category": {
      "const": "anatomy"
    },

    "content": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "definition",
        "location",
        "layers",
        "blood_supply",
        "venous_drainage",
        "innervation",
        "histology_summary",
        "clinical_importance"
      ],

      "properties": {

        "definition": {
          "type": "string",
          "minLength": 1
        },

        "location": {
          "type": "string",
          "minLength": 1
        },

        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },

        "blood_supply": {
          "type": "string",
          "minLength": 1
        },

        "venous_drainage": {
          "type": "string",
          "minLength": 1
        },

        "innervation": {
          "type": "string",
          "minLength": 1
        },

        "histology_summary": {
          "type": "string",
          "minLength": 1
        },

        "clinical_importance": {
          "type": "string",
          "minLength": 1
        }

      }
    },

    "references": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "content_field",
           "sources",
         
        ],

        "properties": {

          "content_field": {
            "type": "string",
            "enum": [
              "definition",
              "location",
              "layers",
              "blood_supply",
              "venous_drainage",
              "innervation",
              "histology_summary",
              "clinical_importance"
            ]
          },

          "sources": {
            "type": "array",
          
            "items": {
              "type": "object",
              "additionalProperties": false,

              "required": [
                "reference_id"
              ],

              "properties": {

                "reference_id": {
                  "type": "string",
                  "minLength": 1
                },

                "chapter": {
                  "type": "string",
                  "minLength": 1
                },

                "pages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },

                "section": {
                  "type": "string",
                  "minLength": 1
                }

              }
            }
          }

        }
      }
    }

  ],

  "required": [
    "category",
    "content",
    "references"
  ]
}

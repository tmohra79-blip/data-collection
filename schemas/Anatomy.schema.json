{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionar.example/knowledge/schemas/anatomy.schema.json",
  "title": "VisionAR Anatomy Entity",
  "type": "object",
  "unevaluatedProperties": false,

  "allOf": [
    { "$ref": "common/base-entity.schema.json" }
  ],

  "required": ["category", "content", "references"],

  "properties": {
    "category": { "const": "anatomy" },

    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition", "location", "layers", "blood_supply",
        "venous_drainage", "innervation", "histology_summary",
        "clinical_importance"
      ],
      "properties": {
        "definition":        { "type": ["string", "null"], "minLength": 1 },
        "location":          { "type": ["string", "null"], "minLength": 1 },
        "layers": {
          "type": ["array", "null"],
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blood_supply":      { "type": ["string", "null"], "minLength": 1 },
        "venous_drainage":   { "type": ["string", "null"], "minLength": 1 },
        "innervation":       { "type": ["string", "null"], "minLength": 1 },
        "histology_summary": { "type": ["string", "null"], "minLength": 1 },
        "clinical_importance": { "type": ["string", "null"], "minLength": 1 }
      }
    },

    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_field", "status", "sources"],

        "properties": {
          "content_field": {
            "type": "string",
            "enum": [
              "definition", "location", "layers", "blood_supply",
              "venous_drainage", "innervation", "histology_summary",
              "clinical_importance"
            ]
          },

          "status": {
            "type": "string",
            "enum": ["documented", "not_applicable", "not_available"]
          },

          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference_id"],
              "properties": {
                "reference_id": { "type": "string", "minLength": 1 },
                "chapter":      { "type": "string", "minLength": 1 },
                "pages": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "section":      { "type": "string", "minLength": 1 }
              },
              "anyOf": [
                { "required": ["section"] },
                { "required": ["chapter", "pages"] }
              ]
            }
          }
        },

        "if": {
          "properties": { "status": { "const": "documented" } }
        },
        "then": {
          "properties": { "sources": { "minItems": 1 } }
        },
        "else": {
          "properties": { "sources": { "maxItems": 0 } }
        }
      }
    }
  }
}